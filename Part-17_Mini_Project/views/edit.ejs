<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Profile</title>
  <link rel="stylesheet" href="/stylesheets/style.css">
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
  <div class="w-full min-h-screen bg-zinc-900 text-white p-10 ">
    <div class="navbar w-full flex justify-end">
      <a  class="bg-red-500 mb-3 px-3 py-2 rounded-md inline-block" href="/logout">logout</a>
    </div>
    <h5 class="mb-4 text-3xl">Edit Your Post</h5>

    <form action="/update/<%= post._id %>" method="post">
       <textarea  class="block w-1/3 p-3 resize-none bg-transparent border-2 border-zinc-800 outline-none rounded-md" name="content" id="content"><%= post.content %></textarea>
       <input class="mt-4 px-3 py-2 bg-yellow-500 block rounded-md" type="submit" value="Update Post">
    </form>
  </div>
  
</body>
</html>