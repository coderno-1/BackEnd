<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Profile</title>
  <link rel="stylesheet" href="/stylesheets/style.css">
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
  <div class="w-full min-h-screen bg-zinc-900 text-white p-10 ">
    <div class="navbar w-full flex justify-end">
      <a  class="bg-red-500 mb-3 px-3 py-2 rounded-md inline-block" href="/logout">logout</a>
    </div>
    <div class="top-heading flex gap-5 mb-8">
    <div class="w-20 h-20 rounded-full overflow-hidden border border-zinc-700">
      <img class="w-full h-full object-cover" src="/images/uploads/<%= user.profilepic %>" alt="profile">
    </div>
    <h1 class="text-3xl mt-4"><span class="font-light">Hello</span>, <%= user.name %> 👋</h1>
  </div>
  <h5 class="mb-4">You can create a new Post.</h5>
    <form action="/post" method="post">
       <textarea placeholder="What's on your mind" class=" block w-1/3 p-3 resize-none bg-transparent border-2 border-zinc-800 outline-none rounded-md " name="content" id="content"></textarea>
       <input class="mt-4 px-3 py-2 bg-blue-500 block rounded-md" type="submit" value="Create New Post">
    </form>
    <div class="posts mt-22">
      <h3 class="text-zinc-400">Your Posts.</h3>
      <div class="postcontainer mt-5">
        <% if (user.posts && user.posts.length > 0) { %>
          <% user.posts.reverse().forEach(function(post) { %>
           <div class="post w-1/3 p-4 mb-5 bg-zinc-800 border border-zinc-600 rounded-md">
             <h4 class="text-blue-500">@ <%= user.username %></h4>
             <p class="text-sm tracking-tight"><%= post.content %></p>
             <small class="mt-2 inline-block"><%= post.likes.length %> likes</small>
             <div class="btn flex gap-3 mt-1">
               <a class="text-blue-500" href="/like/<%= post._id %>">
                  <%= post.likes.indexOf(user._id) === -1 ? "like" : "Unlike" %>
               </a>
               <a class="text-zinc-400" href="/edit/<%= post._id %>">Edit</a>
             </div> 
          </div>
          <% }) %>
        <% } else { %>
          <p class="text-zinc-500">No posts yet.</p>
        <% } %>
        
      </div>
  </div>
  
</body>
</html>