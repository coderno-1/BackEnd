<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sign & Login</title>
  <link rel="stylesheet" href="/stylesheets/style.css">
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
  <div class="w-full h-screen bg-zinc-900 text-white p-10 ">
    <h1 class="text-3xl my-4">Login your Account</h1>
      <form  action="/login" method="post">
        <input class="px-3 py-2 rounded-md bg-transparent border-2 border-zinc-800 outline-none inline-block" type="email" name="email" placeholder="Email & UserName">
        <input class="px-3 py-2 rounded-md bg-transparent border-2 border-zinc-800 outline-none inline-block" type="password" name="password" placeholder="Password">
        <input class="px-5 py-2  mx-5 rounded-md bg-blue-500 border-2 border-zinc-800 cursor-pointer inline-block" type="submit" value="Login Account">
      </form>
  </div>
  
</body>
</html>