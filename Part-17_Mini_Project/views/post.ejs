<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Profile</title>
  <link rel="stylesheet" href="/stylesheets/style.css">
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
  <div class="w-full min-h-screen bg-zinc-900 text-white p-10 ">
    <h3 class="mb-4 text-3xl">Upload File</h3>
    <form autocomplete="off" action="/upload" method="post" enctype="multipart/form-data">
       <input class="text-sm file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-[1px] file:text-sm file:font-semibold file:bg-white-500" type="file" name="image">
       <input class="px-5 py-2 bg-blue-500 rounded-md" type="submit" value="Upload File">
    </form>
  </div>
</body>
</html>