<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <link rel="stylesheet" href="/stylesheets/style.css" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    />
  </head>
  <body class="bg-dark">
    <div class="container mt-5 bg-dark text-white">
      <div class="mb-3">
        <label for="exampleFormControlInput1" class="form-label"
          >Title</label
        >
        <input
          type="text"
          class="title form-control p-3 rounded-3 bg-dark text-white border-secondary"
          id="exampleFormControlInput1"
          placeholder="Title goes here"
        />
      </div>
      <div class="mb-3">
        <label for="exampleFormControlTextarea1" class="form-label"
          >Task details</label
        >
        <textarea
          class=" task form-control p-3 rounded-3 bg-dark text-white border-secondary"
          id="exampleFormControlTextarea1"
          placeholder="Write your task details here"
          rows="3"
        ></textarea>
      /div>

      <div class="mb-3">
        <button class="btn-primary px-4 py-2 rounded-3">Create Task</button>
      </div>

      <div class="mt-5 px-4 py-2 rounded-3 bg-dark text-white border-light" id="task-list">
        <!-- Task items will be appended here -->
         <h1>heloo</h1>
      </div>
<
    <script src="/javascripts/script.js"></script>
  </body>
</html>