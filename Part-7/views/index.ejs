<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Task App</title>

    <!-- Bootstrap -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    />

    <!-- Custom CSS -->
    <link rel="stylesheet" href="/stylesheets/style.css" />
  </head>

  <body class="bg-dark text-white">
    <main class="container mt-5">
      <form action="/create" method="post">
        <input id="titleInput" type="text"
          class="title form-control p-3 rounded-3 bg-dark text-white border-secondary mt-5 mb-3"
          placeholder="Title goes here"
          name="Title"
        />

        <textarea id="taskTextarea"
          class="task form-control p-3 rounded-3 bg-dark text-white border-secondary mt-5 mb-3"
          placeholder="Write your task details here"
          rows="3"
          name="details"
        ></textarea>

        <input class="mt-2 bg-primary px-4 py-2 rounded-4 border-0 text-white" type="submit" value="Create Task" />
      </form>
      <!-- Task List -->
    <section
      id="task-list"
      class="mt-5 p-4 rounded-3 border border-secondary"
    >
      <div class="tasks d-flex flex-wrap">
        <% if(files.length > 0){ %>
          <% files.forEach(function(val){ %>
            <div class="m-5 px-2 py-3 rounded-3 bg-secondary bg-opacity-25">
              <h3 class="mb-1"><%= val %></h3>
              <a class="text-decoration-none" href="/files/<%= val %>">Read More.</a>
            </div>
          <% }) %> 
        <% } else { %>
            <h5 class="text-secondary">No tasks yet</h5>
        <% } %>     
      </div>
    </section>
    </main>

    <script src="/javascripts/script.js"></script>
  </body>
</html>