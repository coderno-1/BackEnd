 <!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Task App</title>

    <!-- Bootstrap -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    />

    <!-- Custom CSS -->
    <link rel="stylesheet" href="/stylesheets/style.css" />
  </head>

<body class="bg-dark text-white modern-page">
  <main class="container mt-5 p-3">
    <a class="back-link fs-5 " href="/">← Go Back to Home</a>

    <form action="/rename" method="post">
        <input id="pastaFileName" type="text"
          class="title form-control p-3 rounded-3 bg-dark text-white border-secondary mt-5 mb-3 "
          name="oldfilename"
          value="<%= filename %>"
        />
        <input id="currentFileName" type="text"
          class="title form-control p-3 rounded-3 bg-dark text-white border-secondary mt-5 mb-3"
          placeholder="choose a new file name"
          name="newfilename"
        />
        <input class="mt-2 bg-warning px-4 py-2 rounded-4 border-0 text-white" type="submit" value="Update Name" />
    </form> 
    </main>
  <script src="/javascripts/script.js"></script>
</body>
</html>