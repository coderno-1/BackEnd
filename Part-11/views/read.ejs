<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
  <link rel="stylesheet" href="/stylesheets/style.css">

  <!-- tailwind -->
  <!-- <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet"> -->
  <script src="https://cdn.tailwindcss.com"></script>

</head>
<body>
   <div class="w-full h-screen bg-zinc-900 p-10 text-white  ">
    <div class="Back mb-10">
      <a href="/" class="text-blue-500 mb-3">Back To Home</a>
    </div>
    <h1 class="text-3xl tracking-tighter mb-3">All Users</h1>
    <div class="users flex gap-3 flex-wrap">
      <% if(Users.length >0) { %>
        
      <% Users.forEach(function(user) { %>
       <div class="user w-90 p-4 bg-zinc-800 rounded-lg">
          <div class="w-full h-72 rounded-lg bg-zinc-700 ">
            <img class="w-full h-full object-fit-cover" src="<%= user.image %>" alt="img">
          </div>
          <h3 class="text-xl mt-3 tracking-tighter"><%= user.name %></h3>
          <h5 class="text-zinc-500"><%= user.email %></h5>    
          <div class="flex mt-4 gap-3">
            <a class="bg-yellow-500 px-4 py-2 rounded-lg" href="#editUser">Edit User</a>
            <a class="bg-red-500 px-4 py-2 rounded-lg" href="/delete/<%= user._id %>">Delete User</a>
         </div>
       </div>
      <% }); %>
      <% } else { %>
        <h2 class="text-zinc-500">No Users yet</h2>
      <% } %>
    </div>
  <script src="script.js"></script>
</body>
</html>