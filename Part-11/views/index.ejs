<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
  <link rel="stylesheet" href="/stylesheets/style.css">

  <!-- tailwind -->
  <!-- <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet"> -->
  <script src="https://cdn.tailwindcss.com"></script>

</head>
<body>
   <div class="w-full h-screen bg-zinc-900 p-10 text-white">
    <div class="nav mb-10">
      <a href="/read" class="bg-green-500 px-4 py-2 rounded-lg">Read Users</a>
    </div>
    <h1 class="text-3xl tracking-tighter mb-3">Create User</h1>

    <form action="/create" method="POST">
      <input class="ps-5 py-3 border-2 border-zinc-800 bg-transparent text-white rounded-lg outline-none" type="text" placeholder="Enter Your Name" name="name">
      <input class="ps-5 py-3 border-2 border-zinc-800 bg-transparent text-white rounded-lg outline-none" type="email" placeholder="Enter Your Email" name="email">
      <input class="ps-5 py-3 border-2 border-zinc-800 bg-transparent text-white rounded-lg outline-none" type="image url" placeholder="Enter Image URL" name="image">

      <input type="submit" value="Create User" class="px-5 py-3 bg-blue-600 rounded-lg cursor-pointer hover:bg-blue-800 ml-5">
    </form>
    
   </div>
  
  <script src="script.js"></script>
</body>
</html>